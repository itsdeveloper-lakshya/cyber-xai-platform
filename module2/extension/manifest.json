{
  "manifest_version": 3,
  "name": "Cyber Sentinel - AI Data Loss Prevention",
  "version": "1.0.0",
  "description": "Client-side privacy and data exfiltration guard for Generative AI tools.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://copilot.microsoft.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "file:///*"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file:///*"
      ],
      "js": [
        "shared/checksums.js",
        "shared/rules.js",
        "shared/feature_extractor.js",
        "shared/scoring_engine.js",
        "content/capture.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Cyber Sentinel DLP"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "config/default_model.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
